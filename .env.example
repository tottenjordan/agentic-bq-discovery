# Copy to .env and fill in. Only GOOGLE_CLOUD_PROJECT is required; every other
# value below is the built-in default, shown so you know what you are changing.
#
#   cp .env.example .env
#
# .env is gitignored. Nothing here is a secret — authentication uses Application
# Default Credentials (`gcloud auth application-default login`).

# --- Required -------------------------------------------------------------
# No default. Every BigQuery, Dataplex, and Vertex call needs it, and defaulting
# would silently target the wrong project.
GOOGLE_CLOUD_PROJECT=

# --- Locations ------------------------------------------------------------
# These are NOT interchangeable. BigQuery datasets live in a multi-region;
# Dataplex data scans must be single-region. The glossary and entry links are
# derived as BQ_LOCATION.lower() and are not configurable separately.
BQ_LOCATION=US
DATAPLEX_LOCATION=us-central1

# --- Models ---------------------------------------------------------------
# Both resolve only at the `global` Vertex endpoint — they return 404 in
# us-central1. The client location is set automatically; do not override it.
AGENT_MODEL=gemini-3.6-flash
TOOL_MODEL=gemini-3.5-flash-lite

# --- Experiment -----------------------------------------------------------
# Prefix for the four tier datasets: {RESOURCE_PREFIX}_tier0 .. _tier3
RESOURCE_PREFIX=bigquery_context
# Tables the reranker returns per question.
TOP_K=5

# Everything above this line is forwarded onto every pipeline task, so a local
# run and a submitted run measure the same thing. Changing any of them changes
# the compiled spec, which is what makes the shard cache notice: without that,
# switching AGENT_MODEL and resubmitting at the same commit would return cells
# scored with the previous model.

# --- Figures (optional) ----------------------------------------------------
# Names the Secret Manager secret holding a Gemini Developer API key, used only
# by `bq-context figures` and by `submit-pipeline --refresh-figures`. Leave it
# empty to run without diagrams. The *name* goes in the compiled spec; the key
# itself is read from Secret Manager at runtime and never leaves it.
# Check access before a run with: bq-context validate-config --require-secret
SECRET_ID=

# --- Pipeline only --------------------------------------------------------
# Required by `compile-pipeline` / `submit-pipeline`, since KFP resolves
# base_image at compile time. Use an immutable SHA tag, never :latest.
# Get it with: make image-ref
BQ_CONTEXT_IMAGE=
